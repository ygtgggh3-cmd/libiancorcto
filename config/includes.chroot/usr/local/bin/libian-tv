def log(msg):
    syslog.syslog(syslog.LOG_INFO, msg)


def guarded(fn):
    """Que un error en un botón no tumbe toda la interfaz; se registra en el journal."""
    def wrapper(*args, **kwargs):
        try:
            return fn(*args, **kwargs)
        except Exception:  # noqa: BLE001
            syslog.syslog(syslog.LOG_ERR, "LIBIAN-TV-ERROR " +
                          traceback.format_exc().replace("\n", " | "))
            return None
    return wrapper


# ---------------------------------------------------------------------------
# Utilidades del sistema
# ---------------------------------------------------------------------------
def cmdline_has(word):
    try:
        with open("/proc/cmdline", encoding="utf-8") as fh:
            return word in fh.read().split()
    except OSError:
        return False


def is_live():
    return cmdline_has("boot=live")


def usb_folder():
    """Carpeta donde se montan los USB (gvfs/udisks), o la carpeta personal."""
    user = os.environ.get("USER") or os.path.basename(os.path.expanduser("~"))
    for base in ("/run/media", "/media"):
        path = os.path.join(base, user)
        try:
            if os.path.isdir(path) and os.listdir(path):
                return path
        except OSError:
            pass
    return os.path.expanduser("~")


def read_mem():
    """(usada_MB, total_MB)."""
    info = {}
    with open("/proc/meminfo", encoding="utf-8") as fh:
        for line in fh:
            key, _, val = line.partition(":")
            parts = val.split()
            if parts:
                info[key] = int(parts[0])
    total = info.get("MemTotal", 0) / 1024.0
    avail = info.get("MemAvailable", info.get("MemFree", 0)) / 1024.0
    return max(total - avail, 0.0), total


def fmt_mem(used, total):
    big = "%.1f GB" % (total / 1024.0) if total >= 1024 else "%d MB" % total
    return "RAM: %d MB / %s" % (used, big)


class CpuMeter:
    def __init__(self):
        self.last = None

    def percent(self):
        with open("/proc/stat", encoding="utf-8") as fh:
            fields = [int(x) for x in fh.readline().split()[1:]]
        idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
        total = sum(fields)
        prev, self.last = self.last, (idle, total)
        if prev is None or total == prev[1]:
            return 0
        return int(round(100.0 * (1 - (idle - prev[0]) / float(total - prev[1]))))


def fmt_date(tm):
    return "%s, %d de %s." % (DIAS[tm.tm_wday], tm.tm_mday, MESES[tm.tm_mon - 1])


# ---------------------------------------------------------------------------
# Wi-Fi con NetworkManager (nmcli): todo se hace dentro de la interfaz
# ---------------------------------------------------------------------------
def split_terse(line):
    """Divide una línea de `nmcli -t` respetando los ':' escapados (\\:)."""
    fields, cur, esc = [], [], False
    for ch in line:
        if esc:
            cur.append(ch)
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            fields.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    fields.append("".join(cur))
    return fields


def run(args, timeout=30):
    try:
        p = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           universal_newlines=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, "", str(exc)


def signal_bars(sig):
    n = 1 if sig < 25 else 2 if sig < 50 else 3 if sig < 75 else 4
    return "▂▄▆█"[:n].ljust(4, "·")


def parse_wifi_list(text):
    nets = {}
    for line in text.splitlines():
        f = split_terse(line)
        if len(f) < 4 or not f[1]:
            continue
        inuse, ssid, signal_s, sec = f[0], f[1], f[2], f[3]
        try:
            sig = int(signal_s)
        except ValueError:
            sig = 0
        cur = nets.get(ssid)
        active = (inuse == "*") or bool(cur and cur["active"])
        if cur is None or sig > cur["signal"] or inuse == "*":
            nets[ssid] = {"ssid": ssid, "signal": sig,
                          "secure": bool(sec and sec != "--"), "active": active}
        else:
            cur["active"] = active
    return sorted(nets.values(), key=lambda n: (not n["active"], -n["signal"], n["ssid"]))


def wifi_networks(rescan=False):
    rc, out, _err = run(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY",
                         "device", "wifi", "list", "--rescan", "yes" if rescan else "auto"], 45)
    return parse_wifi_list(out) if rc == 0 else []


def known_connections():
    rc, out, _err = run(["nmcli", "-t", "-f", "NAME", "connection", "show"], 10)
    return {split_terse(line)[0] for line in out.splitlines()} if rc == 0 else set()


def net_status():
    """{'has_wifi', 'wifi': ssid|None, 'ethernet': bool, 'signal': int}."""
    st = {"has_wifi": False, "wifi": None, "ethernet": False, "signal": 0, "dev": None}
    rc, out, _err = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION",
                         "device", "status"], 10)
    if rc != 0:
        return st
    for line in out.splitlines():
        f = split_terse(line)
        if len(f) < 4:
            continue
        dev, typ, state, conn = f[0], f[1], f[2], f[3]
        if typ == "wifi":
            st["has_wifi"] = True
            st["dev"] = st["dev"] or dev
            if state == "connected":
                st["wifi"] = conn
                st["dev"] = dev
        elif typ == "ethernet" and state == "connected":
            st["ethernet"] = True
    if st["wifi"]:
        for net in wifi_networks(False):
            if net["active"]:
                st["signal"] = net["signal"]
                break
    return st


def wifi_connect(ssid, password=None):
    """Devuelve (ok, mensaje)."""
    if ssid in known_connections():
        rc, out, err = run(["nmcli", "--wait", "25", "connection", "up", "id", ssid], 45)
        if rc == 0:
            return True, ""
        if not password:
            return False, (err or out).strip()
        run(["nmcli", "connection", "delete", "id", ssid], 10)
    args = ["nmcli", "--wait", "25", "device", "wifi", "connect", ssid]
    if password:
        args += ["password", password]
    rc, out, err = run(args, 50)
    if rc != 0:
        run(["nmcli", "connection", "delete", "id", ssid], 10)  # no dejar perfiles rotos
        return False, (err or out).strip()
    return True, ""


def wifi_disconnect(dev):
    if not dev:
        return False
    rc, _out, _err = run(["nmcli", "device", "disconnect", dev], 20)
    return rc == 0


# ---------------------------------------------------------------------------
# Aplicaciones externas
# ---------------------------------------------------------------------------
def exec_from_desktop(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.startswith("Exec="):
                    parts = [p for p in shlex.split(line[5:].strip()) if not p.startswith("%")]
                    return parts or None
    except (OSError, ValueError):
        pass
    return None


def icon_from_desktop(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.startswith("Icon="):
                    return line[5:].strip()
    except OSError:
        pass
    return None


def vacuumtube_desktop():
    found = glob.glob("/usr/share/applications/*[Vv]acuum[Tt]ube*.desktop")
    return found[0] if found else None


def find_vacuumtube():
    """Comando de VacuumTube (YouTube para TV) o None si no está instalado."""
    exe = shutil.which("vacuumtube")
    if exe:
        return [exe]
    desktop = vacuumtube_desktop()
    if desktop:
        args = exec_from_desktop(desktop)
        if args:
            return args
    for path in glob.glob("/opt/*/[Vv]acuum[Tt]ube") + glob.glob("/opt/[Vv]acuum[Tt]ube*/vacuumtube"):
        if os.access(path, os.X_OK):
            return [path]
    return None


