def firefox_command(url):
    """Firefox propio de LIBIAN TV: perfil aparte y sin 'remote', para poder cerrarlo."""
    try:
        os.makedirs(FIREFOX_PROFILE, exist_ok=True)
        userjs = os.path.join(FIREFOX_PROFILE, "user.js")
        if not os.path.exists(userjs):
            with open(userjs, "w", encoding="utf-8") as fh:
                fh.write(FIREFOX_USERJS % os.path.expanduser("~/Descargas").replace('"', ""))
    except OSError:
        pass
    return ["firefox-esr", "--no-remote", "--profile", FIREFOX_PROFILE, "--kiosk", url]


