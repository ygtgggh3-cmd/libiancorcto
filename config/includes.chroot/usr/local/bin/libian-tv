#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""LIBIAN TV: interfaz de Smart TV a pantalla completa (GTK 3).

Códigos de salida (los usa /usr/local/bin/libian-tv-session):
    0  -> la ventana se cerró: la sesión vuelve a lanzar la interfaz
    42 -> el usuario pidió el escritorio XFCE completo
"""
import os
import shutil
import subprocess
import sys
import syslog
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

EXIT_DESKTOP = 42
syslog.openlog("libian-tv")


def is_live():
    try:
        with open("/proc/cmdline", encoding="utf-8") as fh:
            return "boot=live" in fh.read().split()
    except OSError:
        return False


def usb_folder():
    """Carpeta donde se montan los USB (gvfs/udisks), o la carpeta personal."""
    user = os.environ.get("USER") or os.path.basename(os.path.expanduser("~"))
    for base in ("/run/media", "/media"):
        path = os.path.join(base, user)
        try:
            if os.path.isdir(path) and os.listdir(path):
                return path
        except OSError:
            pass
    return os.path.expanduser("~")


# ---------------------------------------------------------------------------
# Definición del menú.  Cada elemento:
#   (glifo, título, descripción, color, acción, comando_requerido)
# Acciones: ("page", nombre) ("cmd", [args]) ("web", url) ("exit", código)
#           ("power", "poweroff"|"reboot")
# Los elementos cuyo comando no está instalado se ocultan automáticamente.
# ---------------------------------------------------------------------------
def web(title, desc, color, url):
    return ("▶", title, desc, color, ("web", url), "firefox-esr")


