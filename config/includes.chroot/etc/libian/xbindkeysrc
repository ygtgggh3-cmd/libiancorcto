# Atajos globales de LIBIAN TV (los lanza libian-tv-session con xbindkeys)
"/usr/local/bin/libian-tv-close"
  control+alt + q

"/usr/local/bin/libian-tv-close"
  XF86HomePage

# Abrir/cerrar el menú de ajustes (además de pulsar Ctrl+Alt a secas)
"/usr/local/bin/libian-tv-menu"
    control+alt + m

"/usr/local/bin/libian-tv-menu"
    XF86Menu
