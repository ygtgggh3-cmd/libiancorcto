# ===== NÚCLEO =====
# Todos los paquetes de este archivo DEBEN existir en Debian trixie.
# scripts/preflight.sh lo comprueba antes de compilar y falla si falta alguno.
# Los paquetes opcionales están en libian-extra.list.chroot.

# Servidor gráfico y sesión
xorg
x11-xserver-utils
xfce4
xfce4-terminal
xfce4-notifyd
xfce4-power-manager
lightdm
lightdm-gtk-greeter
dbus-x11
dbus-user-session
libpam-systemd
polkitd
pkexec
sudo

# Red
network-manager
network-manager-gnome

# Audio
pipewire-audio
pavucontrol
alsa-utils
wireplumber

# Lanzador de TV (Python + GTK 3)
python3
python3-gi
python3-gi-cairo
gir1.2-gtk-3.0
desktop-file-utils
fonts-dejavu
adwaita-icon-theme

# Navegador y multimedia
firefox-esr
mpv

# Control desde el menú (cerrar/atrás/recargar en el navegador, atajos globales)
xdotool
xbindkeys
wmctrl
xinput
pulseaudio-utils

# Archivos y USB
thunar
thunar-volman
gvfs
gvfs-backends
udisks2
ntfs-3g
exfatprogs

# Idioma, teclado y hora
locales
keyboard-configuration
console-setup

# Instalador (Calamares, el instalador de las imágenes live de Debian 13)
calamares
calamares-settings-debian
grub-pc
grub-efi-amd64-bin
efibootmgr
os-prober

# Dependencias que antes llegaban como «recomendados» (ahora se instalan sin ellos para ahorrar espacio)
